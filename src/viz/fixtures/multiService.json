  "flows": [
    {
      "id": "soft-decline",
      "title": "Soft decline, then success",
      "summary": "A soft-declined charge is queued, retried by the worker after backoff, and checkout learns the result by polling.",
      "delta": "added",
      "participants": [
        "shopper",
        "checkout",
        "billing-api",
        "stripe",
        "retry-queue",
        "retry-worker",
        "payments-db"
      ],
      "steps": [
        {
          "from": "shopper",
          "to": "checkout",
          "label": "Pay",
          "delta": "unchanged",
          "phase": "Checkout"
        },
        {
          "from": "checkout",
          "to": "billing-api",
          "label": "POST /charges",
          "delta": "unchanged",
          "request": "{ cartId, paymentMethodId }"
        },
        { "from": "billing-api", "to": "stripe", "label": "charge", "delta": "unchanged" },
        {
          "from": "stripe",
          "to": "billing-api",
          "label": "card_declined (soft)",
          "kind": "return",
          "delta": "changed"
        },
        {
          "from": "billing-api",
          "to": "payments-db",
          "label": "insert attempt #1",
          "files": [{ "path": "services/billing/api.go", "line": 140, "endLine": 151 }]
        },
        {
          "from": "billing-api",
          "to": "retry-queue",
          "label": "enqueue retry +30s",
          "kind": "async",
          "request": "{ chargeId, attempt: 2, notBefore }",
          "files": [{ "path": "services/billing/api.go", "line": 152, "endLine": 160 }]
        },
        {
          "from": "billing-api",
          "to": "checkout",
          "label": "202 pending",
          "kind": "return",
          "response": "{ paymentId, status: \"pending\" }"
        },
        {
          "from": "checkout",
          "to": "billing-api",
          "label": "GET /payments/:id (poll)",
          "phase": "Retry",
          "note": "Polls every 3s, gives up after 2 minutes."
        },
        { "from": "retry-queue", "to": "retry-worker", "label": "deliver", "kind": "async" },
        { "from": "retry-worker", "to": "retry-worker", "label": "backoff check" },
        { "from": "retry-worker", "to": "stripe", "label": "re-charge" },
        { "from": "stripe", "to": "retry-worker", "label": "succeeded", "kind": "return" },
        { "from": "retry-worker", "to": "payments-db", "label": "mark paid" },
        {
          "from": "billing-api",
          "to": "checkout",
          "label": "status: paid",
          "kind": "return",
          "phase": "Settled"
        }
      ]
    },
    {
      "id": "final-failure",
      "title": "Third decline emails the shopper",
      "summary": "After the last attempt fails the worker emits payment.failed once, and Notify sends one email.",
      "delta": "changed",
      "participants": ["retry-worker", "stripe", "payments-db", "events", "notify"],
      "steps": [
        {
          "from": "retry-worker",
          "to": "stripe",
          "label": "re-charge (attempt 3)",
          "delta": "added"
        },
        {
          "from": "stripe",
          "to": "retry-worker",
          "label": "declined",
          "kind": "return",
          "delta": "added"
        },
        { "from": "retry-worker", "to": "payments-db", "label": "mark failed", "delta": "added" },
        {
          "from": "retry-worker",
          "to": "events",
          "label": "payment.failed",
          "kind": "async",
          "delta": "added",
          "request": "{ paymentId, attempts: 3, reason }"
        },
        {
          "from": "events",
          "to": "notify",
          "label": "deliver",
          "kind": "async",
          "delta": "unchanged"
        },
        {
          "from": "notify",
          "to": "notify",
          "label": "skip unless attempts = 3",
          "delta": "changed",
          "files": [
            { "path": "services/notify/handlers/payment_failed.go", "line": 22, "endLine": 30 }
          ]
        }
      ]
    }
