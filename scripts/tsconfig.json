{
  // Type-checks the repo's TypeScript dev tooling on its own, separate from the extension build:
  // these files (esbuild.mts, emulator.ts) run directly on Node's type-stripping, never emit, and
  // live outside the extension's rootDir ("src"). check-types runs this alongside the root.
  //
  // rootDir is the repo root so the build script at the top level can be included here rather than
  // needing a fourth tsconfig of its own.
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2022",
    "lib": ["ES2022"],
    "rootDir": "..",
    "strict": true,
    "noEmit": true,
    // Node's ESM resolution does no extension guessing, so these files import each other by their
    // real `.mts` path. Nothing here is emitted, so allowing that is purely a typechecking concern.
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["**/*.ts", "../esbuild.mts", "../src/plugins/**/*.mts"]
}
