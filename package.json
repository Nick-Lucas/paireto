{
  "name": "paireto",
  "displayName": "Paireto",
  "version": "0.22.0",
  "description": "Paireto — VS Code companion for terminal-first AI coding agents.",
  "categories": [
    "Other"
  ],
  "license": "ELv2",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nick-Lucas/paireto"
  },
  "publisher": "Paireto",
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "pnpm run prepackage",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.mts",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.mts --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "prepackage": "pnpm run check-types && pnpm run lint && node esbuild.mts --production",
    "package": "vsce package --no-dependencies --out dist/paireto.vsix",
    "compile-tests": "rm -rf out && tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit && tsc -p scripts && tsc -p src/welcome/webview",
    "dogfood": "pnpm package && code --install-extension dist/paireto.vsix --force",
    "publish:minor": "vsce publish minor --no-dependencies",
    "lint": "oxlint src",
    "format": "oxfmt --check src",
    "autofix": "oxlint --fix src && oxfmt src",
    "test": "vscode-test",
    "e2e:record": "pnpm run compile && pnpm run compile-tests && PAIRETO_E2E_MODE=record node out/e2e/runE2E.js",
    "e2e:check": "pnpm run compile && pnpm run compile-tests && PAIRETO_E2E_MODE=check node out/e2e/runE2E.js",
    "e2e:check:docker": "bash docker/e2e.sh check",
    "e2e:record:docker": "bash docker/e2e.sh record",
    "docker:build": "docker compose -f docker/docker-compose.yml build",
    "docker:down": "docker compose -f docker/docker-compose.yml down --remove-orphans",
    "docker:shell": "docker compose -f docker/docker-compose.yml up -d --wait && docker compose -f docker/docker-compose.yml exec tests bash",
    "test:docker": "docker compose -f docker/docker-compose.yml up -d --wait && docker compose -f docker/docker-compose.yml exec -T tests pnpm test",
    "emulator": "node esbuild.mts --emulator-bridge && node scripts/emulator.ts"
  },
  "dependencies": {
    "dedent": "^1.7.2",
    "jsonc-parser": "^3.3.1",
    "nanoid": "^6.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "~26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "mocha": "^11.8.0",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  },
  "contributes": {
    "commands": [
      {
        "command": "paireto.switcher.open",
        "title": "Paireto: Switch Repository / Worktree",
        "icon": "$(repo)"
      },
      {
        "command": "paireto.switcher.openInThisWindow",
        "title": "Paireto: Open Selected in This Window"
      },
      {
        "command": "paireto.openWelcome",
        "title": "Paireto: Open Welcome"
      },
      {
        "command": "paireto.gate.approve",
        "title": "Paireto: Approve",
        "icon": "media/approve.svg"
      },
      {
        "command": "paireto.gate.sendFeedback",
        "title": "Paireto: Send Feedback",
        "icon": "media/send-feedback.svg"
      },
      {
        "command": "paireto.submit",
        "title": "Paireto: Submit Feedback or Approve if no Feedback"
      },
      {
        "command": "paireto.comment.edit",
        "title": "Edit Comment",
        "icon": "$(edit)"
      },
      {
        "command": "paireto.comment.save",
        "title": "Save Comment",
        "icon": "$(check)"
      },
      {
        "command": "paireto.comment.delete",
        "title": "Delete Comment",
        "icon": "$(trash)"
      },
      {
        "command": "paireto.plan.addComment",
        "title": "Comment",
        "enablement": "!commentIsEmpty"
      },
      {
        "command": "paireto.plan.addQuestion",
        "title": "Question",
        "enablement": "!commentIsEmpty"
      },
      {
        "command": "paireto.review.refresh",
        "title": "Paireto: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "paireto.review.pickCompareTo",
        "title": "Paireto: Compare To…",
        "icon": "$(git-compare)"
      },
      {
        "command": "paireto.review.pickDiffCompareTo",
        "title": "Paireto: Compare To…",
        "icon": "$(git-compare)"
      },
      {
        "command": "paireto.review.toggleLayout",
        "title": "Paireto: Toggle Flat / Tree View",
        "icon": "$(list-tree)"
      },
      {
        "command": "paireto.review.openDiff",
        "title": "Open Changes"
      },
      {
        "command": "paireto.review.openFile",
        "title": "Open File",
        "icon": "$(go-to-file)"
      },
      {
        "command": "paireto.review.stage",
        "title": "Stage Changes",
        "icon": "$(add)"
      },
      {
        "command": "paireto.review.unstage",
        "title": "Unstage Changes",
        "icon": "$(remove)"
      },
      {
        "command": "paireto.review.stageAll",
        "title": "Paireto: Stage All Changes",
        "icon": "$(add)"
      },
      {
        "command": "paireto.review.unstageAll",
        "title": "Paireto: Unstage All Changes",
        "icon": "$(remove)"
      },
      {
        "command": "paireto.review.discard",
        "title": "Discard Changes",
        "icon": "$(discard)"
      },
      {
        "command": "paireto.review.discardAll",
        "title": "Paireto: Discard All Changes",
        "icon": "$(discard)"
      },
      {
        "command": "paireto.review.addComment",
        "title": "Comment",
        "enablement": "!commentIsEmpty"
      },
      {
        "command": "paireto.review.addQuestion",
        "title": "Question",
        "enablement": "!commentIsEmpty"
      },
      {
        "command": "paireto.review.revealComment",
        "title": "Reveal Comment"
      },
      {
        "command": "paireto.review.deleteComment",
        "title": "Delete Comment",
        "icon": "$(trash)"
      },
      {
        "command": "paireto.focusAgent",
        "title": "Paireto: Focus Agent",
        "icon": "$(terminal)"
      },
      {
        "command": "paireto.agent.switch",
        "title": "Switch to Agent"
      },
      {
        "command": "paireto.agent.hide",
        "title": "Hide Agent",
        "icon": "$(eye)"
      },
      {
        "command": "paireto.agent.show",
        "title": "Show Agent",
        "icon": "$(eye-closed)"
      },
      {
        "command": "paireto.guidedReview.openFile",
        "title": "Open Changes"
      },
      {
        "command": "paireto.guidedReview.openChangeset",
        "title": "Open Changeset"
      },
      {
        "command": "paireto.guidedReview.openPlan",
        "title": "Open Review Plan"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "paireto",
          "title": "Paireto",
          "icon": "media/paireto.svg"
        }
      ]
    },
    "keybindings": [
      {
        "command": "paireto.switcher.open",
        "key": "cmd+shift+k",
        "mac": "cmd+shift+k",
        "win": "ctrl+shift+k",
        "linux": "ctrl+shift+k"
      },
      {
        "command": "paireto.switcher.openInThisWindow",
        "key": "shift+enter",
        "when": "paireto.switcherVisible"
      }
    ],
    "views": {
      "paireto": [
        {
          "id": "paireto.main",
          "name": "Paireto",
          "type": "tree",
          "icon": "media/paireto.svg"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "paireto.switcher.openInThisWindow",
          "when": "false"
        },
        {
          "command": "paireto.submit",
          "when": "paireto.planPending || paireto.reviewSessionActive"
        },
        {
          "command": "paireto.plan.addQuestion",
          "when": "false"
        },
        {
          "command": "paireto.plan.addComment",
          "when": "false"
        },
        {
          "command": "paireto.review.addQuestion",
          "when": "false"
        },
        {
          "command": "paireto.review.addComment",
          "when": "false"
        },
        {
          "command": "paireto.review.openDiff",
          "when": "false"
        },
        {
          "command": "paireto.review.pickDiffCompareTo",
          "when": "false"
        },
        {
          "command": "paireto.review.openFile",
          "when": "false"
        },
        {
          "command": "paireto.review.stage",
          "when": "false"
        },
        {
          "command": "paireto.review.unstage",
          "when": "false"
        },
        {
          "command": "paireto.review.discard",
          "when": "false"
        },
        {
          "command": "paireto.review.revealComment",
          "when": "false"
        },
        {
          "command": "paireto.review.deleteComment",
          "when": "false"
        },
        {
          "command": "paireto.gate.approve",
          "when": "false"
        },
        {
          "command": "paireto.gate.sendFeedback",
          "when": "false"
        },
        {
          "command": "paireto.comment.edit",
          "when": "false"
        },
        {
          "command": "paireto.comment.save",
          "when": "false"
        },
        {
          "command": "paireto.comment.delete",
          "when": "false"
        },
        {
          "command": "paireto.agent.switch",
          "when": "false"
        },
        {
          "command": "paireto.agent.hide",
          "when": "false"
        },
        {
          "command": "paireto.agent.show",
          "when": "false"
        },
        {
          "command": "paireto.guidedReview.openFile",
          "when": "false"
        },
        {
          "command": "paireto.guidedReview.openChangeset",
          "when": "false"
        },
        {
          "command": "paireto.guidedReview.openPlan",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "paireto.review.pickDiffCompareTo",
          "when": "paireto.reviewDiffActive",
          "group": "navigation@1"
        },
        {
          "command": "paireto.gate.approve",
          "when": "resourceScheme == paireto-plan && !paireto.gateHasFeedback",
          "group": "navigation@1"
        },
        {
          "command": "paireto.gate.sendFeedback",
          "when": "resourceScheme == paireto-plan && paireto.gateHasFeedback",
          "group": "navigation@2"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "paireto.plan.addComment",
          "when": "commentController == paireto.plan",
          "group": "inline@1"
        },
        {
          "command": "paireto.plan.addQuestion",
          "when": "commentController == paireto.plan",
          "group": "inline@2"
        },
        {
          "command": "paireto.review.addComment",
          "when": "commentController == paireto.review",
          "group": "inline@1"
        },
        {
          "command": "paireto.review.addQuestion",
          "when": "commentController == paireto.review",
          "group": "inline@2"
        }
      ],
      "comments/comment/title": [
        {
          "command": "paireto.comment.edit",
          "when": "(commentController == paireto.plan || commentController == paireto.review) && comment == preview",
          "group": "group@1"
        },
        {
          "command": "paireto.comment.delete",
          "when": "(commentController == paireto.plan || commentController == paireto.review) && comment == preview",
          "group": "group@2"
        }
      ],
      "comments/comment/context": [
        {
          "command": "paireto.comment.save",
          "when": "(commentController == paireto.plan || commentController == paireto.review) && comment == editing",
          "group": "inline@1"
        }
      ],
      "view/item/context": [
        {
          "command": "paireto.review.pickCompareTo",
          "when": "view == paireto.main && viewItem == section:files",
          "group": "inline@1"
        },
        {
          "command": "paireto.review.toggleLayout",
          "when": "view == paireto.main && viewItem == section:files",
          "group": "inline@2"
        },
        {
          "command": "paireto.focusAgent",
          "when": "view == paireto.main && viewItem =~ /^agentSession/",
          "group": "inline@1"
        },
        {
          "command": "paireto.agent.hide",
          "when": "view == paireto.main && viewItem == agentSession",
          "group": "inline@2"
        },
        {
          "command": "paireto.agent.show",
          "when": "view == paireto.main && viewItem == agentSession:muted",
          "group": "inline@2"
        },
        {
          "command": "paireto.review.deleteComment",
          "when": "view == paireto.main && viewItem == reviewComment",
          "group": "inline@1"
        },
        {
          "command": "paireto.review.discardAll",
          "when": "view == paireto.main && viewItem == group:unstaged",
          "group": "inline@1"
        },
        {
          "command": "paireto.review.stageAll",
          "when": "view == paireto.main && viewItem == group:unstaged",
          "group": "inline@2"
        },
        {
          "command": "paireto.review.unstageAll",
          "when": "view == paireto.main && viewItem == group:staged",
          "group": "inline@1"
        },
        {
          "command": "paireto.review.openFile",
          "when": "view == paireto.main && viewItem =~ /^changedFile:/",
          "group": "inline@1"
        },
        {
          "command": "paireto.review.discard",
          "when": "view == paireto.main && viewItem =~ /^changedFile:unstaged/",
          "group": "inline@2"
        },
        {
          "command": "paireto.review.stage",
          "when": "view == paireto.main && viewItem =~ /^changedFile:unstaged/",
          "group": "inline@3"
        },
        {
          "command": "paireto.review.unstage",
          "when": "view == paireto.main && viewItem =~ /^changedFile:staged/",
          "group": "inline@2"
        },
        {
          "command": "paireto.review.openFile",
          "when": "view == paireto.main && viewItem =~ /^changedFile:/",
          "group": "1_open@1"
        },
        {
          "command": "paireto.review.openDiff",
          "when": "view == paireto.main && viewItem =~ /^changedFile:/",
          "group": "1_open@2"
        },
        {
          "command": "paireto.review.stage",
          "when": "view == paireto.main && viewItem =~ /^changedFile:unstaged/",
          "group": "2_git@1"
        },
        {
          "command": "paireto.review.discard",
          "when": "view == paireto.main && viewItem =~ /^changedFile:unstaged/",
          "group": "2_git@2"
        },
        {
          "command": "paireto.review.unstage",
          "when": "view == paireto.main && viewItem =~ /^changedFile:staged/",
          "group": "2_git@1"
        },
        {
          "command": "paireto.review.stage",
          "when": "view == paireto.main && viewItem == folder:unstaged",
          "group": "inline@2"
        },
        {
          "command": "paireto.review.discard",
          "when": "view == paireto.main && viewItem == folder:unstaged",
          "group": "inline@1"
        },
        {
          "command": "paireto.review.unstage",
          "when": "view == paireto.main && viewItem == folder:staged",
          "group": "inline@1"
        },
        {
          "command": "paireto.review.stage",
          "when": "view == paireto.main && viewItem == folder:unstaged",
          "group": "2_git@1"
        },
        {
          "command": "paireto.review.discard",
          "when": "view == paireto.main && viewItem == folder:unstaged",
          "group": "2_git@2"
        },
        {
          "command": "paireto.review.unstage",
          "when": "view == paireto.main && viewItem == folder:staged",
          "group": "2_git@1"
        },
        {
          "command": "paireto.review.unstageAll",
          "when": "view == paireto.main && (viewItem == changeset:unstage || viewItem == changeset:both)",
          "group": "inline@1"
        },
        {
          "command": "paireto.review.stageAll",
          "when": "view == paireto.main && (viewItem == changeset:stage || viewItem == changeset:both)",
          "group": "inline@2"
        },
        {
          "command": "paireto.review.stageAll",
          "when": "view == paireto.main && (viewItem == changeset:stage || viewItem == changeset:both)",
          "group": "2_git@1"
        },
        {
          "command": "paireto.review.unstageAll",
          "when": "view == paireto.main && (viewItem == changeset:unstage || viewItem == changeset:both)",
          "group": "2_git@2"
        }
      ],
      "view/title": [
        {
          "command": "paireto.review.refresh",
          "when": "view == paireto.main",
          "group": "navigation@3"
        },
        {
          "command": "paireto.gate.approve",
          "when": "view == paireto.main && (paireto.planPending || paireto.reviewSessionActive) && !paireto.gateHasFeedback",
          "group": "navigation@4"
        },
        {
          "command": "paireto.gate.sendFeedback",
          "when": "view == paireto.main && (paireto.planPending || paireto.reviewSessionActive) && paireto.gateHasFeedback",
          "group": "navigation@5"
        }
      ]
    },
    "configuration": {
      "title": "Paireto",
      "properties": {
        "paireto.logLevel": {
          "type": "string",
          "enum": [
            "error",
            "info",
            "debug"
          ],
          "default": "info",
          "description": "Paireto's log level."
        },
        "paireto.notify.type": {
          "type": "string",
          "enum": [
            "sound",
            "disabled"
          ],
          "enumDescriptions": [
            "Play the selected sound when an agent needs you.",
            "No sound (the sidebar, status bar, and switcher indicators still update)."
          ],
          "default": "sound",
          "description": "How to alert you when one of this window's agents finishes a turn or needs input (stopped / awaiting plan / awaiting permission)."
        },
        "paireto.notify.sound": {
          "type": "string",
          "default": "Ping",
          "description": "Sound played when 'paireto.notify.type' is 'sound': a system-sound name (e.g. macOS 'Glass', 'Ping', 'Hero') or an absolute path to a sound file."
        },
        "paireto.review.mode": {
          "type": "string",
          "enum": [
            "automatic",
            "manual"
          ],
          "enumDescriptions": [
            "Open a Review automatically when the agent finishes a turn that edited files.",
            "Only start a review if you have queued comments when the agent finishes, or when running /paireto-review from your agent."
          ],
          "default": "automatic",
          "description": "When Paireto opens a code Review at the end of an agent's turn."
        },
        "paireto.planApprove.mode.claudecode": {
          "type": "string",
          "enum": [
            "auto",
            "acceptEdits",
            "default",
            "plan",
            "off"
          ],
          "default": "auto",
          "description": "Permission mode Claude Code enters when you approve its plan: auto (auto-approve with background safety checks), acceptEdits (auto-approve file edits), default (ask for permission), plan (stay in plan mode), off (leave the mode unchanged). Codex Stop hooks cannot change collaboration mode, so Codex has no equivalent key and still presents its native approve-and-switch action."
        },
        "paireto.planApprove.mode.opencode": {
          "type": "string",
          "enum": [
            "build",
            "off"
          ],
          "default": "build",
          "description": "The OpenCode agent to switch to and proceed as when a plan is approved. \"off\" stays on the plan agent; a custom agent name can be typed in settings.json."
        }
      }
    }
  },
  "activationEvents": [
    "onFileSystem:paireto-changeset",
    "onFileSystem:paireto-review",
    "onStartupFinished"
  ],
  "icon": "media/PairetoAppIcon@2x.png",
  "engines": {
    "vscode": "^1.125.0"
  },
  "packageManager": "pnpm@11.21.0"
}
