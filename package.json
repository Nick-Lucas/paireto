      ],
      "editor/title": [
        {
          "command": "crafty.review.pickDiffCompareTo",
          "when": "crafty.reviewDiffActive",
          "group": "navigation@1"
        },
        {
          "command": "crafty.gate.approve",
          "when": "resourceScheme == crafty-plan && !crafty.gateHasFeedback",
          "group": "navigation@1"
        },
        {
          "command": "crafty.gate.sendFeedback",
          "when": "resourceScheme == crafty-plan && crafty.gateHasFeedback",
          "group": "navigation@2"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "crafty.plan.addComment",
          "when": "commentController == crafty.plan && !commentThread",
          "group": "inline@1"
        },
        {
          "command": "crafty.plan.addQuestion",
          "when": "commentController == crafty.plan && !commentThread",
          "group": "inline@2"
        },
        {
          "command": "crafty.plan.addReply",
          "when": "commentController == crafty.plan && commentThread == open",
          "group": "inline@1"
        },
        {
          "command": "crafty.review.addComment",
          "when": "commentController == crafty.review && !commentThread",
          "group": "inline@1"
        },
        {
          "command": "crafty.review.addQuestion",
          "when": "commentController == crafty.review && !commentThread",
          "group": "inline@2"
        },
        {
          "command": "crafty.review.addReply",
          "when": "commentController == crafty.review && commentThread == open",
          "group": "inline@1"
        },
        {
          "command": "crafty.review.unresolveAndReply",
          "when": "commentController == crafty.review && commentThread == resolved",
          "group": "inline@1"
        }
      ],
      "comments/comment/title": [
        {
          "command": "crafty.comment.edit",
          "when": "(commentController == crafty.plan || commentController == crafty.review) && comment == preview",
          "group": "group@1"
        },
        {
          "command": "crafty.comment.delete",
          "when": "(commentController == crafty.plan || commentController == crafty.review) && comment == preview",
          "group": "group@2"
        }
      ],
      "comments/comment/context": [
        {
          "command": "crafty.comment.save",
          "when": "(commentController == crafty.plan || commentController == crafty.review) && comment == editing",
          "group": "inline@1"
        }
      ],
      "view/item/context": [
        {
          "command": "crafty.review.pickCompareTo",
          "when": "view == crafty.main && viewItem == section:files",
          "group": "inline@1"
        },
        {
          "command": "crafty.review.toggleLayout",
          "when": "view == crafty.main && viewItem == section:files",
          "group": "inline@2"
        },
        {
          "command": "crafty.focusAgent",
          "when": "view == crafty.main && viewItem =~ /^agentSession/",
          "group": "inline@1"
        },
        {
          "command": "crafty.agent.hide",
          "when": "view == crafty.main && viewItem == agentSession",
          "group": "inline@2"
        },
        {
          "command": "crafty.agent.show",
          "when": "view == crafty.main && viewItem == agentSession:muted",
          "group": "inline@2"
        },
        {
          "command": "crafty.review.deleteComment",
          "when": "view == crafty.main && viewItem == reviewComment",
          "group": "inline@1"
        },
        {
          "command": "crafty.review.clearFeedback",
          "when": "view == crafty.main && viewItem == section:feedback",
          "group": "inline@1"
        },
        {
          "command": "crafty.review.discardAll",
          "when": "view == crafty.main && viewItem == group:unstaged",
          "group": "inline@1"
        },
        {
          "command": "crafty.review.stageAll",
          "when": "view == crafty.main && viewItem == group:unstaged",
          "group": "inline@2"
        },
        {
          "command": "crafty.review.unstageAll",
          "when": "view == crafty.main && viewItem == group:staged",
          "group": "inline@1"
        },
        {
          "command": "crafty.review.openFile",
          "when": "view == crafty.main && viewItem =~ /^changedFile:/",
          "group": "inline@1"
        },
        {
          "command": "crafty.review.discard",
          "when": "view == crafty.main && viewItem =~ /^changedFile:unstaged/",
          "group": "inline@2"
        },
        {
          "command": "crafty.review.stage",
          "when": "view == crafty.main && viewItem =~ /^changedFile:unstaged/",
          "group": "inline@3"
        },
        {
          "command": "crafty.review.unstage",
          "when": "view == crafty.main && viewItem =~ /^changedFile:staged/",
          "group": "inline@2"
        },
        {
          "command": "crafty.review.openFile",
          "when": "view == crafty.main && viewItem =~ /^changedFile:/",
          "group": "1_open@1"
        },
        {
          "command": "crafty.review.openDiff",
          "when": "view == crafty.main && viewItem =~ /^changedFile:/",
          "group": "1_open@2"
        },
        {
          "command": "crafty.review.copyPath",
          "when": "view == crafty.main && viewItem =~ /^changedFile:/",
          "group": "3_copy@1"
        },
        {
          "command": "crafty.review.revealInExplorer",
          "when": "view == crafty.main && viewItem =~ /^changedFile:/",
          "group": "4_reveal@1"
        },
        {
          "command": "crafty.review.stage",
          "when": "view == crafty.main && viewItem =~ /^changedFile:unstaged/",
          "group": "2_git@1"
        },
        {
          "command": "crafty.review.discard",
          "when": "view == crafty.main && viewItem =~ /^changedFile:unstaged/",
          "group": "2_git@2"
        },
        {
          "command": "crafty.review.unstage",
          "when": "view == crafty.main && viewItem =~ /^changedFile:staged/",
          "group": "2_git@1"
        },
        {
          "command": "crafty.review.stage",
          "when": "view == crafty.main && viewItem == folder:unstaged",
          "group": "inline@2"
        },
        {
          "command": "crafty.review.discard",
          "when": "view == crafty.main && viewItem == folder:unstaged",
          "group": "inline@1"
        },
        {
          "command": "crafty.review.unstage",
          "when": "view == crafty.main && viewItem == folder:staged",
          "group": "inline@1"
        },
        {
          "command": "crafty.review.stage",
          "when": "view == crafty.main && viewItem == folder:unstaged",
          "group": "2_git@1"
        },
        {
          "command": "crafty.review.discard",
          "when": "view == crafty.main && viewItem == folder:unstaged",
          "group": "2_git@2"
        },
        {
          "command": "crafty.review.unstage",
          "when": "view == crafty.main && viewItem == folder:staged",
          "group": "2_git@1"
        },
        {
          "command": "crafty.review.unstageAll",
          "when": "view == crafty.main && (viewItem == changeset:unstage || viewItem == changeset:both)",
          "group": "inline@1"
        },
        {
          "command": "crafty.review.stageAll",
          "when": "view == crafty.main && (viewItem == changeset:stage || viewItem == changeset:both)",
          "group": "inline@2"
        },
        {
          "command": "crafty.review.stageAll",
          "when": "view == crafty.main && (viewItem == changeset:stage || viewItem == changeset:both)",
          "group": "2_git@1"
        },
        {
          "command": "crafty.review.unstageAll",
          "when": "view == crafty.main && (viewItem == changeset:unstage || viewItem == changeset:both)",
          "group": "2_git@2"
        }
      ],
      "view/title": [
        {
          "command": "crafty.review.refresh",
          "when": "view == crafty.main",
          "group": "navigation@3"
        },
        {
          "command": "crafty.gate.approve",
          "when": "view == crafty.main && (crafty.planPending || crafty.reviewSessionActive) && !crafty.gateHasFeedback",
          "group": "navigation@4"
        },
        {
          "command": "crafty.gate.sendFeedback",
          "when": "view == crafty.main && (crafty.planPending || crafty.reviewSessionActive) && crafty.gateHasFeedback",
          "group": "navigation@5"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "crafty.review.resolveThread",
          "when": "commentController == crafty.review && commentThread == open",
          "group": "inline@1"
        },
        {
          "command": "crafty.review.unresolveThread",
          "when": "commentController == crafty.review && commentThread == resolved",
          "group": "inline@1"
        }
      ]
    },
    "configuration": {
      "title": "Crafty",
      "properties": {
        "crafty.logLevel": {
          "type": "string",
          "enum": [
            "error",
            "info",
            "debug"
          ],
          "default": "info",
          "description": "Crafty's log level."
        },
        "crafty.notify.type": {
          "type": "string",
          "enum": [
            "sound",
            "disabled"
          ],
          "enumDescriptions": [
            "Play the selected sound when an agent needs you.",
            "No sound (the sidebar, status bar, and switcher indicators still update)."
          ],
          "default": "sound",
          "description": "How to alert you when one of this window's agents finishes a turn or needs input (stopped / awaiting plan / awaiting permission)."
        },
        "crafty.notify.sound": {
          "type": "string",
          "default": "Ping",
          "description": "Sound played when 'crafty.notify.type' is 'sound': a system-sound name (e.g. macOS 'Glass', 'Ping', 'Hero') or an absolute path to a sound file."
        },
        "crafty.review.mode": {
          "type": "string",
          "enum": [
            "automatic",
            "manual"
          ],
          "enumDescriptions": [
            "Open a Review automatically when the agent finishes a turn that edited files.",
            "Only start a review if you have queued comments when the agent finishes, if an agent has answered a comment, or when running /crafty-review from your agent."
          ],
          "default": "automatic",
          "description": "When Crafty opens a code Review at the end of an agent's turn."
        },
        "crafty.planApprove.mode.claudecode": {
          "type": "string",
          "enum": [
            "auto",
            "acceptEdits",
            "default",
            "plan",
            "off"
          ],
          "default": "auto",
          "description": "Permission mode Claude Code enters when you approve its plan: auto (auto-approve with background safety checks), acceptEdits (auto-approve file edits), default (ask for permission), plan (stay in plan mode), off (leave the mode unchanged). Codex Stop hooks cannot change collaboration mode, so Codex has no equivalent key and still presents its native approve-and-switch action."
        },
        "crafty.planApprove.mode.opencode": {
          "type": "string",
          "enum": [
            "build",
            "off"
          ],
          "default": "build",
          "description": "The OpenCode agent to switch to and proceed as when a plan is approved. \"off\" stays on the plan agent; a custom agent name can be typed in settings.json."
        }
      }
    }
  },
  "activationEvents": [
    "onFileSystem:crafty-changeset",
    "onFileSystem:crafty-review",
    "onStartupFinished"
  ],
  "icon": "media/CraftyAppIcon@2x.png",
  "engines": {
    "vscode": "^1.125.0"
  },
  "packageManager": "pnpm@11.21.0"
}
