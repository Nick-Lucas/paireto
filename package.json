{
  "name": "crafty",
  "displayName": "Crafty",
  "version": "0.25.0",
  "description": "Crafty — shape what your terminal-first AI coding agents make, inside VS Code.",
  "categories": [
    "Other"
  ],
  "license": "ELv2",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nick-Lucas/paireto"
  },
  "publisher": "Crafty",
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "pnpm run prepackage",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.mts",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.mts --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "prepackage": "pnpm run check-types && pnpm run lint && node esbuild.mts --production",
    "package": "vsce package --no-dependencies --out dist/crafty.vsix",
    "compile-tests": "rm -rf out && tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit && tsc -p scripts && tsc -p src/welcome/webview",
    "dogfood": "pnpm package && code --install-extension dist/crafty.vsix --force",
    "publish:minor": "vsce publish minor --no-dependencies",
    "lint": "oxlint src",
    "format": "oxfmt --check src",
    "autofix": "oxlint --fix src && oxfmt src",
    "test": "vscode-test",
    "e2e:record": "pnpm run compile && pnpm run compile-tests && CRAFTY_E2E_MODE=record node out/e2e/runE2E.js",
    "e2e:check": "pnpm run compile && pnpm run compile-tests && CRAFTY_E2E_MODE=check node out/e2e/runE2E.js",
    "e2e:check:docker": "bash docker/e2e.sh check",
    "e2e:record:docker": "bash docker/e2e.sh record",
    "docker:build": "docker compose -f docker/docker-compose.yml build",
    "docker:down": "docker compose -f docker/docker-compose.yml down --remove-orphans",
    "docker:shell": "docker compose -f docker/docker-compose.yml up -d --wait && docker compose -f docker/docker-compose.yml exec tests bash",
    "test:docker": "docker compose -f docker/docker-compose.yml up -d --wait && docker compose -f docker/docker-compose.yml exec -T tests pnpm test",
    "emulator": "node esbuild.mts --emulator-bridge && node scripts/emulator.ts",
    "postinstall": "node scripts/refreshSchemas.mts",
    "refresh-schemas": "node scripts/refreshSchemas.mts",
    "bump-harnesses": "node scripts/bumpHarnessVersions.mts"
  },
  "dependencies": {
    "dedent": "^1.7.2",
    "immer": "^11.1.18",
    "jsonc-parser": "^3.3.1",
    "nanoid": "^6.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "~26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "mocha": "^11.8.0",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  },
  "contributes": {
    "commands": [
      {
        "command": "crafty.switcher.open",
        "title": "Crafty: Switch Repository / Worktree",
        "icon": "$(repo)"
      },
      {
        "command": "crafty.switcher.openInThisWindow",
        "title": "Crafty: Open Selected in This Window"
      },
      {
        "command": "crafty.openWelcome",
        "title": "Crafty: Open Welcome"
      },
      {
        "command": "crafty.gate.approve",
        "title": "Crafty: Approve",
        "icon": "media/approve.svg"
      },
      {
        "command": "crafty.gate.sendFeedback",
        "title": "Crafty: Send Feedback",
        "icon": "media/send-feedback.svg"
      },
      {
        "command": "crafty.submit",
        "title": "Crafty: Submit Feedback or Approve if no Feedback"
      },
      {
        "command": "crafty.comment.edit",
        "title": "Edit Comment",
        "icon": "$(edit)"
      },
      {
        "command": "crafty.comment.save",
        "title": "Save Comment",
        "icon": "$(check)"
      },
      {
        "command": "crafty.comment.delete",
        "title": "Delete Comment",
        "icon": "$(trash)"
      },
      {
        "command": "crafty.plan.addComment",
        "title": "Comment",
        "enablement": "!commentIsEmpty"
      },
      {
        "command": "crafty.plan.addQuestion",
        "title": "Question",
        "enablement": "!commentIsEmpty"
      },
      {
        "command": "crafty.plan.addReply",
        "title": "Reply",
        "enablement": "!commentIsEmpty"
      },
      {
        "command": "crafty.review.refresh",
        "title": "Crafty: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "crafty.review.pickCompareTo",
        "title": "Crafty: Compare To…",
        "icon": "$(git-compare)"
      },
      {
        "command": "crafty.review.pickDiffCompareTo",
        "title": "Crafty: Compare To…",
        "icon": "$(git-compare)"
      },
      {
        "command": "crafty.review.toggleLayout",
        "title": "Crafty: Toggle Flat / Tree View",
        "icon": "$(list-tree)"
      },
      {
        "command": "crafty.review.openDiff",
        "title": "Open Changes"
      },
      {
        "command": "crafty.review.openFile",
        "title": "Open File",
        "icon": "$(go-to-file)"
      },
      {
        "command": "crafty.review.copyPath",
        "title": "Copy Path"
      },
      {
        "command": "crafty.review.revealInExplorer",
        "title": "Focus in Explorer"
      },
      {
        "command": "crafty.review.stage",
        "title": "Stage Changes",
        "icon": "$(add)"
      },
      {
        "command": "crafty.review.unstage",
        "title": "Unstage Changes",
        "icon": "$(remove)"
      },
      {
        "command": "crafty.review.stageAll",
        "title": "Crafty: Stage All Changes",
        "icon": "$(add)"
      },
      {
        "command": "crafty.review.unstageAll",
        "title": "Crafty: Unstage All Changes",
        "icon": "$(remove)"
      },
      {
        "command": "crafty.review.discard",
        "title": "Discard Changes",
        "icon": "$(discard)"
      },
      {
        "command": "crafty.review.discardAll",
        "title": "Crafty: Discard All Changes",
        "icon": "$(discard)"
      },
      {
        "command": "crafty.review.addComment",
        "title": "Comment",
        "enablement": "!commentIsEmpty"
      },
      {
        "command": "crafty.review.addReply",
        "title": "Reply",
        "enablement": "!commentIsEmpty"
      },
      {
        "command": "crafty.review.unresolveThread",
        "title": "Unresolve"
      },
      {
        "command": "crafty.review.resolveThread",
        "title": "Resolve"
      },
      {
        "command": "crafty.review.unresolveAndReply",
        "title": "Unresolve & Reply",
        "enablement": "!commentIsEmpty"
      },
      {
        "command": "crafty.review.addQuestion",
        "title": "Question",
        "enablement": "!commentIsEmpty"
      },
      {
        "command": "crafty.review.revealComment",
        "title": "Reveal Comment"
      },
      {
        "command": "crafty.review.deleteComment",
        "title": "Delete Comment",
        "icon": "$(trash)"
      },
      {
        "command": "crafty.review.clearFeedback",
        "title": "Clear All Feedback",
        "icon": "$(clear-all)"
      },
      {
        "command": "crafty.focusAgent",
        "title": "Crafty: Focus Agent",
        "icon": "$(terminal)"
      },
      {
        "command": "crafty.agent.switch",
        "title": "Switch to Agent"
      },
      {
        "command": "crafty.agent.hide",
        "title": "Hide Agent",
        "icon": "$(eye)"
      },
      {
        "command": "crafty.agent.show",
        "title": "Show Agent",
        "icon": "$(eye-closed)"
      },
      {
        "command": "crafty.guidedReview.openFile",
        "title": "Open Changes"
      },
      {
        "command": "crafty.guidedReview.openChangeset",
        "title": "Open Changeset"
      },
      {
        "command": "crafty.guidedReview.openPlan",
        "title": "Open Review Plan"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "crafty",
          "title": "Crafty",
          "icon": "media/crafty.svg"
        }
      ]
    },
    "keybindings": [
      {
        "command": "crafty.switcher.open",
        "key": "cmd+shift+k",
        "mac": "cmd+shift+k",
        "win": "ctrl+shift+k",
        "linux": "ctrl+shift+k"
      },
      {
        "command": "crafty.switcher.openInThisWindow",
        "key": "shift+enter",
        "when": "crafty.switcherVisible"
      }
    ],
    "views": {
      "crafty": [
        {
          "id": "crafty.main",
          "name": "Crafty",
          "type": "tree",
          "icon": "media/crafty.svg"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "crafty.switcher.openInThisWindow",
          "when": "false"
        },
        {
          "command": "crafty.submit",
          "when": "crafty.planPending || crafty.reviewSessionActive"
        },
        {
          "command": "crafty.plan.addQuestion",
          "when": "false"
        },
        {
          "command": "crafty.plan.addComment",
          "when": "false"
        },
        {
          "command": "crafty.plan.addReply",
          "when": "false"
        },
        {
          "command": "crafty.review.addQuestion",
          "when": "false"
        },
        {
          "command": "crafty.review.addComment",
          "when": "false"
        },
        {
          "command": "crafty.review.addReply",
          "when": "false"
        },
        {
          "command": "crafty.review.openDiff",
          "when": "false"
        },
        {
          "command": "crafty.review.pickDiffCompareTo",
          "when": "false"
        },
        {
          "command": "crafty.review.openFile",
          "when": "false"
        },
        {
          "command": "crafty.review.copyPath",
          "when": "false"
        },
        {
          "command": "crafty.review.revealInExplorer",
          "when": "false"
        },
        {
          "command": "crafty.review.stage",
          "when": "false"
        },
        {
          "command": "crafty.review.unstage",
          "when": "false"
        },
        {
          "command": "crafty.review.discard",
          "when": "false"
        },
        {
          "command": "crafty.review.revealComment",
          "when": "false"
        },
        {
          "command": "crafty.review.deleteComment",
          "when": "false"
        },
        {
          "command": "crafty.review.clearFeedback",
          "when": "false"
        },
        {
          "command": "crafty.gate.approve",
          "when": "false"
        },
        {
          "command": "crafty.gate.sendFeedback",
          "when": "false"
        },
        {
          "command": "crafty.comment.edit",
          "when": "false"
        },
        {
          "command": "crafty.comment.save",
          "when": "false"
        },
        {
          "command": "crafty.comment.delete",
          "when": "false"
        },
        {
          "command": "crafty.agent.switch",
